<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>SAHRA TEA HOUSE</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

body{
    font-family:Arial, sans-serif;
    background:#0b0906;
    color:#fff;
    overflow-x:hidden;
}

header{
    position:fixed;
    top:0;
    width:100%;
    z-index:1000;
    padding:18px 7%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    background:rgba(11,9,6,.85);
    backdrop-filter:blur(15px);
    border-bottom:1px solid rgba(255,255,255,.08);
}

.logo{
    font-size:24px;
    font-weight:bold;
    letter-spacing:3px;
}

.logo span{
    color:#d6a84f;
}

nav a{
    color:#fff;
    text-decoration:none;
    margin-left:25px;
    font-size:14px;
}

nav a:hover{
    color:#d6a84f;
}

.hero{
    min-height:100vh;
    display:flex;
    align-items:center;
    padding:120px 7% 70px;
    background:
    radial-gradient(circle at 80% 30%,rgba(214,168,79,.18),transparent 35%),
    radial-gradient(circle at 20% 80%,rgba(128,73,25,.15),transparent 35%);
}

.hero-content{
    max-width:700px;
}

.tag{
    color:#d6a84f;
    letter-spacing:4px;
    font-size:13px;
    margin-bottom:20px;
}

h1{
    font-size:clamp(50px,9vw,100px);
    line-height:.95;
    margin-bottom:25px;
}

h1 span{
    color:#d6a84f;
}

.hero p{
    color:#bbb;
    max-width:550px;
    line-height:1.7;
    margin-bottom:35px;
}

.btn{
    display:inline-block;
    padding:15px 28px;
    border-radius:30px;
    background:#d6a84f;
    color:#0b0906;
    text-decoration:none;
    font-weight:bold;
    transition:.3s;
}

.btn:hover{
    transform:translateY(-4px);
    box-shadow:0 10px 30px rgba(214,168,79,.25);
}

section{
    padding:100px 7%;
}

.section-title{
    text-align:center;
    margin-bottom:55px;
}

.section-title small{
    color:#d6a84f;
    letter-spacing:3px;
}

.section-title h2{
    font-size:45px;
    margin-top:10px;
}

.menu{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
    gap:25px;
}

.card{
    background:linear-gradient(145deg,#18130d,#0f0d09);
    border:1px solid rgba(214,168,79,.15);
    border-radius:20px;
    padding:30px;
    transition:.3s;
}

.card:hover{
    transform:translateY(-8px);
    border-color:#d6a84f;
}

.icon{
    font-size:50px;
    margin-bottom:20px;
}

.card h3{
    margin-bottom:10px;
}

.card p{
    color:#999;
    line-height:1.6;
    font-size:14px;
}

.price{
    display:block;
    color:#d6a84f;
    font-size:22px;
    font-weight:bold;
    margin-top:20px;
}

.about{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:60px;
    align-items:center;
}

.about-box{
    background:#15110c;
    padding:40px;
    border-radius:25px;
    border:1px solid rgba(214,168,79,.15);
}

.about h2{
    font-size:45px;
    margin-bottom:20px;
}

.about p{
    color:#aaa;
    line-height:1.8;
}

.features{
    margin-top:30px;
    display:grid;
    gap:15px;
}

.feature{
    padding:15px;
    background:#0d0b08;
    border-radius:12px;
}

.contact{
    text-align:center;
    background:
    radial-gradient(circle,rgba(214,168,79,.12),transparent 55%);
}

.contact h2{
    font-size:50px;
    margin-bottom:20px;
}

.contact p{
    color:#aaa;
    margin-bottom:30px;
}

.info{
    margin-top:30px;
    color:#aaa;
    line-height:2;
}

footer{
    padding:30px 7%;
    text-align:center;
    color:#777;
    border-top:1px solid rgba(255,255,255,.08);
    font-size:13px;
}

@media(max-width:700px){

    nav{
        display:none;
    }

    .hero{
        padding-top:150px;
    }

    .about{
        grid-template-columns:1fr;
    }

    .about h2{
        font-size:36px;
    }

    .section-title h2{
        font-size:36px;
    }

    .contact h2{
        font-size:38px;
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">SAHRA<span>TEA</span></div>

    <nav>
        <a href="#home">Home</a>
        <a href="#menu">Menu</a>
